[Unit]
Description=Set CPU governor and clock limit for Orange Pi Zero power stability
DefaultDependencies=no
After=sysinit.target local-fs.target
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for cpu in /sys/devices/system/cpu/cpu[0-3]; do [ -d "$cpu/cpufreq" ] && echo ondemand > "$cpu/cpufreq/scaling_governor" && echo 1008000 > "$cpu/cpufreq/scaling_max_freq" 2>/dev/null || true; done'

[Install]
WantedBy=basic.target
